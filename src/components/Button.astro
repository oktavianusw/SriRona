---
interface Props {
	href: string;
	label: string;
	size?: 'lg' | 'md' | 'sm';
	variant?: 'primary' | 'secondary';
}
const { href, label, size = 'md', variant = 'primary' } = Astro.props;
const external = href.startsWith('http');
---

<a class:list={['button', 't-body-m-strong', size, variant]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
	<span class="roll"><span data-text={label}>{label}</span></span>
	<slot />
</a>

<style>
	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		height: 44px;
		padding: 12px 20px;
		border-radius: 12px;
		background: var(--button-bg);
		color: var(--button-text);
		user-select: none;
	}
	.secondary {
		background: var(--neutral-01);
		color: var(--neutral-08);
		box-shadow: inset 0 0 0 1px var(--neutral-03);
	}
	.roll {
		height: 23px;
	}
	.lg {
		height: 48px;
	}
	.button :global(svg) {
		flex: none;
		width: 18px;
		height: 18px;
		color: var(--neutral-01);
	}
	.sm {
		height: 38px;
		padding: 12px 16px;
	}
</style>
