---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Logo from './Logo.astro';
import background from '../assets/framer/1yjjlVoTnHH4K5HR64OHDOlSVdU.webp';
import { INSTAGRAM_URL, LINKEDIN_URL, EMAIL_URL } from '../consts';
import { langOf, localePath, useT } from '../i18n';

const t = useT(Astro);
const lang = langOf(Astro);

const groups = [
	{
		title: 'Navigation',
		links: [
			{ href: localePath('/', lang), label: 'Home' },
			{ href: localePath('/work', lang), label: 'Work' },
			{ href: localePath('/about', lang), label: 'About Us' },
			{ href: localePath('/contact', lang), label: 'Contact' },
		],
	},
	{
		title: 'Connect',
		links: [
			{ href: LINKEDIN_URL, label: 'Linkedin' },
			{ href: INSTAGRAM_URL, label: 'Instagram' },
		],
	},
];
---

<footer class="footer">
	<div class="card">
		<Image class="background" src={background} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="lazy" />
		<div class="shade"></div>
		<div class="content">
			<div class="cta">
				<Logo />
				<div class="text">
					<h2 class="headline t-h1b">{t('Tertarik Berdiskusi?', 'Up for a Chat?')}</h2>
					<p class="lead t-body-m">
						{t('Ceritakan kebutuhan kreatifmu, kami siap bersama-sama temukan solusi terbaiknya.', "Tell us about your creative needs, and let's find the best solution together.")}
					</p>
				</div>
				<Button href={EMAIL_URL} label={t('Diskusikan sekarang', "Let's talk")} />
			</div>
			<div class="groups">
				{
					groups.map(({ title, links }) => (
						<div class="group">
							<p class="t-body-xs">{title}</p>
							<ul>
								{links.map(({ href, label }) => (
									<li>
										<a class="t-body-s-strong" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>
											{label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		display: flex;
		min-height: 100vh;
		padding: var(--nav-height) 12px 12px;
	}
	.card {
		position: relative;
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 80px 40px 24px;
		border-radius: 40px;
		background: var(--primary-02);
		overflow: clip;
	}
	.background {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		mask: linear-gradient(0deg, #000 -5%, transparent 70%);
	}
	.shade {
		position: absolute;
		inset: auto 0 0;
		height: 95px;
		background: linear-gradient(180deg, rgb(32 32 32 / 0), var(--neutral-08));
	}
	.content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 60px;
		width: 100%;
	}
	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		width: 100%;
		max-width: 600px;
	}
	.text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		width: 100%;
	}
	.headline {
		text-align: center;
	}
	.lead {
		max-width: 450px;
		text-align: center;
		text-wrap: balance;
	}
	.groups {
		display: flex;
		justify-content: center;
		gap: 100px;
		width: 100%;
	}
	.group {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.group ul {
		display: flex;
		gap: 12px;
	}
	.group a {
		display: block;
		position: relative;
		color: var(--neutral-08);
		white-space: pre;
	}
	.group a::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		border-bottom: 1px dashed var(--neutral-07);
	}

	@media (max-width: 809px) {
		.footer {
			min-height: 0;
			padding: 12px;
		}
		.card {
			padding: 60px 20px 20px;
		}
		.groups {
			flex-wrap: wrap;
			justify-content: flex-start;
			gap: 10px 40px;
		}
	}
</style>
