---
import Button from './Button.astro';
import Logo from './Logo.astro';
import { EMAIL_URL } from '../consts';
import { basePath, langOf, localePath, useT } from '../i18n';

const t = useT(Astro);
const lang = langOf(Astro);
const links = [
	{ href: '/work', label: t('Karya', 'Work') },
	{ href: '/about', label: t('Tentang kami', 'About us') },
	{ href: '/contact', label: t('Kontak', 'Contact') },
];
// The switcher links to this same page in the other language.
const base = basePath(Astro.url.pathname);
const langs = [
	{ code: 'id', label: 'ID', name: 'Bahasa Indonesia' },
	{ code: 'en', label: 'EN', name: 'English' },
] as const;
---

<nav class="nav" aria-label={t('Utama', 'Main')}>
	<div class="bar">
		<Logo class="nav-logo" />
		<button class="toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
			<span class="sr-only">Menu</span>
			<span class="line"></span>
			<span class="line"></span>
		</button>
	</div>
	<div class="menu" id="nav-menu">
		<div class="menu-inner">
			<ul class="links">
				{
					links.map(({ href, label }) => (
						<li>
							<a class="link t-body-s" href={localePath(href, lang)}>
								<span class="roll">
									<span data-text={label}>{label}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<ul class="langs t-body-s-strong" aria-label={t('Bahasa', 'Language')}>
				{
					langs.map(({ code, label, name }) => (
						<li>
							<a href={localePath(base, code)} hreflang={code} lang={code} aria-label={name} aria-current={code === lang ? 'true' : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
			<Button href={EMAIL_URL} label={t('Diskusikan sekarang', "Let's talk")} size="sm" />
		</div>
	</div>
</nav>

<script>
	const nav = document.querySelector('.nav')!;
	const toggle = nav.querySelector<HTMLButtonElement>('.toggle')!;
	toggle.addEventListener('click', () => {
		const open = nav.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(open));
	});
</script>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 9;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 12px var(--gutter);
		background: var(--primary-01);
	}
	.bar,
	.menu-inner,
	.links {
		display: flex;
		align-items: center;
	}
	.menu-inner {
		gap: 32px;
	}
	.links {
		gap: 20px;
	}
	.link {
		display: block;
		color: var(--neutral-08);
	}
	.link .roll {
		height: 20px;
	}
	.toggle {
		display: none;
	}
	.langs {
		display: flex;
		gap: 2px;
		padding: 2px;
		border-radius: 10px;
		background: var(--neutral-03);
	}
	.langs a {
		display: block;
		padding: 4px 8px;
		border-radius: 8px;
		color: var(--neutral-07);
		transition: color 0.2s var(--ease);
	}
	.langs a:hover {
		color: var(--neutral-08);
	}
	.langs [aria-current] {
		background: var(--neutral-01);
		color: var(--neutral-08);
		box-shadow: 0 1px 2px var(--neutral-08-20);
	}

	@media (max-width: 1199px) {
		.nav {
			display: block;
		}
		.bar {
			justify-content: space-between;
		}
		.toggle {
			display: block;
			position: relative;
			width: 32px;
			height: 32px;
		}
		.line {
			position: absolute;
			left: 4px;
			width: 24px;
			height: 2px;
			border-radius: 100px;
			background: var(--primary-04);
			transition:
				top 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
				transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		.line:nth-of-type(2) {
			top: 10px;
		}
		.line:nth-of-type(3) {
			top: 20px;
		}
		.open .line {
			top: 15px;
		}
		.open .line:nth-of-type(2) {
			transform: rotate(45deg);
		}
		.open .line:nth-of-type(3) {
			transform: rotate(-45deg);
		}

		/* Collapsed to zero height; grid rows animate the open/close. */
		.menu {
			display: grid;
			grid-template-rows: 0fr;
			visibility: hidden;
			transition:
				grid-template-rows 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
				visibility 0.35s;
		}
		.open .menu {
			grid-template-rows: 1fr;
			visibility: visible;
		}
		.menu-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 24px;
			min-height: 0;
			overflow: clip;
		}
		.open .menu-inner {
			overflow: visible;
		}
		.links {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
			padding-top: 32px;
		}
		.menu-inner > :global(.button) {
			margin-bottom: 28px;
		}
	}

	@media (max-width: 809px) {
		.nav :global(.nav-logo span) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.line,
		.menu {
			transition: none;
		}
	}
</style>
