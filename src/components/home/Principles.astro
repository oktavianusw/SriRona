---
import { principles } from '../../data/principles';
---

<section class="principles">
	<h2 class="t-h1b">Prinsip Desain</h2>
	{
		principles.map(({ title, text }) => (
			<div class="item">
				<h3 class="t-subtitle-l">{title}</h3>
				<p class="t-body-l">{text}</p>
			</div>
		))
	}
</section>

<style>
	.principles {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 48px;
		padding: 100px 0 150px;
		background: var(--button-bg);
		text-align: center;
	}
	h2 {
		font-weight: 700;
		color: var(--neutral-01);
	}
	.item {
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: 1000px;
		text-wrap: balance;
	}

	@media (max-width: 1199px) {
		.principles {
			gap: 32px;
			height: 693px;
			padding: 0;
		}
		.item {
			width: 700px;
		}
	}

	@media (max-width: 809px) {
		.principles {
			gap: 48px;
			height: auto;
			padding: 120px 20px 150px;
		}
		h2 {
			text-wrap: balance;
		}
		.item {
			width: min(349px, 100%);
		}
	}
</style>
