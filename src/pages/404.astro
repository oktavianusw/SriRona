---
import Button from '../components/Button.astro';
import ArrowRight from '../icons/arrow-right.svg';
import Base from '../layouts/Base.astro';
---

<Base title="Halaman tidak ditemukan" description="Halaman yang kamu cari tidak ada.">
	<div class="page">
		<div class="inner">
			<div class="text">
				<h1 class="t-h1b" data-appear>This page isn’t here.</h1>
				<p class="t-body-m" data-appear style="--appear-delay: 0.2s">
					The page you’re looking for may have moved or no longer exists. Let’s get you back on track.
				</p>
			</div>
			<Button href="/" label="Back to Home">
				<ArrowRight aria-hidden="true" />
			</Button>
		</div>
	</div>
</Base>

<style>
	.page {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100vh;
	}
	.inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
		width: 100%;
		max-width: 600px;
	}
	.text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		width: 100%;
		text-align: center;
	}
	.text p {
		max-width: 400px;
		text-wrap: balance;
	}

	@media (max-width: 809px) {
		.page {
			padding: 0 20px;
		}
	}
</style>
