---
import { EMAIL_URL, WEB3FORMS_KEY } from '../consts';
import Faq from '../components/Faq.astro';
import Base from '../layouts/Base.astro';
import { langOf, localePath, useT } from '../i18n';

const t = useT(Astro);
const privacyUrl = localePath('/legal/privacy-policy', langOf(Astro));
const submitLabel = t('Kirim', 'Submit');
const intro = t(
	'Ceritakan kebutuhan kreatifmu, kami siap bersama-sama temukan solusi terbaiknya.',
	"Tell us about your creative needs, and let's find the best solution together.",
);
// Status messages for the form script, in the page's language.
const messages = {
	thanks: t('Terima kasih!', 'Thank you!'),
	received: t('Pesanmu sudah kami terima.', 'We have received your message.'),
	sent: t('Pesanmu sudah terkirim. Kami akan membalas lewat email secepatnya.', "Your message is on its way. We'll reply by email as soon as we can."),
	inactive: t('Formulir belum aktif', 'This form is not active yet'),
	inactiveText: t('Sementara, kirim pesanmu langsung ke', 'For now, please send your message directly to'),
	failed: t('Pesan belum terkirim', "Your message wasn't sent"),
	failedText: t('Coba lagi sebentar lagi, atau kirim langsung ke', 'Please try again shortly, or send it directly to'),
	sending: t('Mengirim…', 'Sending…'),
	didYouMean: t('Maksudmu', 'Did you mean'),
	submit: submitLabel,
};
---

<Base title={t('Kontak', 'Contact')} description={intro}>
	<div class="page">
		<header>
			<h1>
				<span class="t-h1b" data-appear>{t('Tertarik', 'Up for')}</span>
				<span class="t-h1 accent" data-appear style="--appear-delay: 0.2s">{t('Berdiskusi?', 'a Chat?')}</span>
			</h1>
			<p class="t-body-m" data-appear style="--appear-delay: 0.4s">{intro}</p>
		</header>
		<div class="form-card">
			<form method="post" data-key={WEB3FORMS_KEY} data-messages={JSON.stringify(messages)}>
				<div class="fields">
				<label>
					<span class="t-body-m-strong">{t('Nama', 'Name')}</span>
					<input type="text" name="name" placeholder={t('Masukkan namamu', 'Enter your name')} autocomplete="name" required />
				</label>
				<label>
					<span class="t-body-m-strong">Email</span>
					<input type="email" name="email" placeholder={t('namakamu@gmail.com', 'yourname@gmail.com')} autocomplete="email" required aria-describedby="email-hint" />
					<p class="email-hint t-body-s" id="email-hint" aria-live="polite" hidden></p>
				</label>
				<label>
					<span class="t-body-m-strong">
						{t('Nomor Telepon', 'Phone Number')} <span class="optional">{t('(opsional)', '(optional)')}</span>
					</span>
					<input type="tel" name="phone" placeholder={t('Masukkan nomor teleponmu', 'Enter your phone number')} autocomplete="tel" />
				</label>
				<label class="message">
					<span class="t-body-m-strong">{t('Pesan', 'Message')}</span>
					<textarea name="message" placeholder={t('Ceritakan tentang proyekmu', 'Tell us about your project')} required></textarea>
				</label>
				<!-- Honeypot: real visitors never see or fill this. -->
				<input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<button class="submit t-body-m-strong" type="submit">
					<span class="roll"><span data-text={submitLabel}>{submitLabel}</span></span>
				</button>
				<p class="note t-body-s">
					<span>{t('Kami biasanya membalas dalam 1–2 hari kerja.', 'We usually reply within 1–2 business days.')}</span>
					<span>
						{t('Dengan mengirim formulir ini, kamu menyetujui ', 'By submitting this form, you agree to our ')}<a href={privacyUrl}>{t('Kebijakan Privasi', 'Privacy Policy')}</a>{t(' kami.', '.')}
					</span>
				</p>
				</div>
				<div class="status t-body-m" role="status" aria-live="polite" tabindex="-1" hidden>
					<p class="status-title t-subtitle-m"></p>
					<p class="status-text"></p>
					<a class="status-mail" href={EMAIL_URL} hidden>studiosrirona@gmail.com</a>
				</div>
			</form>
		</div>
		<p class="alt t-body-s">
			{t('Lebih suka email?', 'Prefer email?')} <a href={EMAIL_URL}>studiosrirona@gmail.com</a>
		</p>
	</div>
	<Faq />
</Base>

<script>
	import { suggestEmail } from '../lib/email-typo';

	const form = document.querySelector<HTMLFormElement>('.form-card form')!;
	const button = form.querySelector<HTMLButtonElement>('.submit')!;
	const label = button.querySelector<HTMLElement>('.roll > span')!;
	const status = form.querySelector<HTMLElement>('.status')!;
	const [title, text] = status.querySelectorAll<HTMLElement>('p');
	const mail = status.querySelector<HTMLElement>('.status-mail')!;
	const m = JSON.parse(form.dataset.messages!) as Record<string, string>;

	const show = (kind: 'sent' | 'error', heading: string, body: string) => {
		// Keep the card's height when the fields hide, so the page doesn't jump.
		if (kind === 'sent') form.style.minHeight = `${form.offsetHeight}px`;
		form.dataset.state = kind;
		title.textContent = heading;
		text.textContent = body;
		mail.hidden = kind !== 'error';
		status.hidden = false;
		status.focus();
	};

	// Email typo hint ("gmail.con" → "gmail.com"): shown on leaving the field and once on submit.
	const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
	const hint = form.querySelector<HTMLElement>('.email-hint')!;
	let warned = '';
	const checkEmail = () => {
		const suggestion = suggestEmail(email.value.trim());
		hint.hidden = !suggestion;
		if (!suggestion) return false;
		const fix = document.createElement('button');
		fix.type = 'button';
		fix.textContent = suggestion;
		fix.addEventListener('click', () => {
			email.value = suggestion;
			hint.hidden = true;
			email.focus();
		});
		hint.replaceChildren(`${m.didYouMean} `, fix, '?');
		return true;
	};
	email.addEventListener('change', checkEmail);

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		// Stop once so the visitor sees the hint; submitting the same address again sends it as typed.
		if (email.value !== warned && checkEmail()) {
			warned = email.value;
			return email.focus();
		}
		const data = new FormData(form);
		// Honeypot: a bot filled the hidden field. Pretend it worked, send nothing.
		if (data.get('website')) return show('sent', m.thanks, m.received);

		const key = form.dataset.key;
		if (!key) return show('error', m.inactive, m.inactiveText);

		button.disabled = true;
		label.textContent = m.sending;
		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify({
					access_key: key,
					subject: 'Pesan baru dari website SriRona',
					from_name: 'Website SriRona',
					name: data.get('name'),
					email: data.get('email'),
					phone: data.get('phone') || '-',
					message: data.get('message'),
				}),
			});
			const result = await response.json();
			if (!response.ok || !result.success) throw new Error(result.message);
			form.reset();
			show('sent', m.thanks, m.sent);
		} catch {
			show('error', m.failed, m.failedText);
			button.disabled = false;
			label.textContent = m.submit;
		}
	});
</script>

<style>
	.page {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 60px;
		max-width: 600px;
		margin: 0 auto;
		padding-top: 140px;
	}
	header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		width: 100%;
		max-width: 400px;
	}
	h1 {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0 12px;
	}
	.accent {
		color: var(--primary-04);
	}
	header p {
		width: 100%;
		text-align: center;
		text-wrap: balance;
	}

	.form-card {
		width: 100%;
		padding: 12px;
		border-radius: 40px;
		background: var(--primary-02);
	}
	form {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 20px;
		border-radius: 28px;
		background: var(--neutral-01);
		box-shadow:
			inset 0 0 0 1px var(--primary-03),
			0 0.6px 0.6px -1.25px rgb(0 0 0 / 0.18),
			0 2.29px 2.29px -2.5px rgb(0 0 0 / 0.16),
			0 10px 10px -3.75px rgb(0 0 0 / 0.06);
	}
	label {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	label > span {
		color: var(--neutral-07);
	}
	.message {
		padding-bottom: 16px;
	}
	.email-hint {
		margin-top: -4px;
		color: var(--neutral-07);
	}
	.email-hint :global(button) {
		color: var(--neutral-08);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.email-hint[hidden] {
		display: none;
	}
	.optional {
		font-weight: 400;
		color: var(--neutral-06);
	}
	.note {
		text-align: center;
		text-wrap: balance;
	}
	.note > span {
		display: block;
	}
	.alt {
		margin-top: -36px; /* sits close under the card instead of the page's 60px gap */
		text-align: center;
	}
	.note a,
	.alt a {
		color: var(--neutral-08);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	input,
	textarea {
		width: 100%;
		padding: 14px;
		border: 1px solid var(--neutral-04);
		border-radius: 10px;
		background: var(--neutral-02);
		color: var(--neutral-08);
		font: 400 16px/1.2 var(--font-display);
		letter-spacing: 0;
		transition:
			background-color 0.2s var(--ease),
			border-color 0.2s var(--ease);
	}
	input {
		height: 44px;
	}
	textarea {
		min-height: 160px;
		resize: vertical;
	}
	input::placeholder,
	textarea::placeholder {
		color: var(--neutral-06);
	}
	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--primary-03);
		background: var(--neutral-01);
	}
	.trap {
		position: absolute;
		width: 0;
		height: 0;
		padding: 0;
		border: 0;
		opacity: 0;
		pointer-events: none;
	}
	.fields {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	/* After a successful send only the message shows; on error the fields stay so the visitor can retry. */
	form[data-state='sent'] .fields {
		display: none;
	}
	form[data-state='sent'] {
		justify-content: center;
	}
	.status {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 40px 12px;
		text-align: center;
		outline: none;
	}
	.status[hidden] {
		display: none;
	}
	form[data-state='error'] .status {
		padding: 0 4px;
		text-align: left;
	}
	.status-title {
		color: var(--neutral-08);
	}
	.status-mail {
		color: var(--neutral-08);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.submit:disabled {
		opacity: 0.6;
		cursor: progress;
	}
	.submit {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 44px;
		border-radius: 12px;
		background: var(--neutral-08);
		color: var(--neutral-01);
	}
	.submit .roll {
		height: 23px;
	}

	@media (max-width: 809px) {
		.page {
			gap: 40px;
			padding: 100px 20px 0;
		}
		header p {
			text-wrap: wrap;
		}
		.form-card {
			padding: 8px;
			border-radius: 24px;
		}
		form {
			border-radius: 16px;
		}
	}
</style>
