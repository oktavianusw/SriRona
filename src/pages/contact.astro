---
import Faq from '../components/Faq.astro';
import Base from '../layouts/Base.astro';

const intro = 'Ceritakan kebutuhan kreatifmu, kami siap bersama-sama temukan solusi terbaiknya.';
---

<Base title="Kontak" description={intro}>
	<div class="page">
		<header>
			<h1>
				<span class="t-h1b" data-appear>Tertarik</span>
				<span class="t-h1 accent" data-appear style="--appear-delay: 0.2s">Berdiskusi?</span>
			</h1>
			<p class="t-body-m" data-appear style="--appear-delay: 0.4s">{intro}</p>
		</header>
		<div class="form-card">
			<form method="post" novalidate>
				<label>
					<span class="t-body-m-strong">Name</span>
					<input type="text" name="name" placeholder="Enter your name" autocomplete="name" required />
				</label>
				<label>
					<span class="t-body-m-strong">Email</span>
					<input type="email" name="email" placeholder="yourname@gmail.com" autocomplete="email" required />
				</label>
				<label>
					<span class="t-body-m-strong">Phone Number</span>
					<input type="tel" name="phone" placeholder="Enter your phone number" autocomplete="tel" />
				</label>
				<label class="message">
					<span class="t-body-m-strong">Message</span>
					<textarea name="message" placeholder="Tell us about your project" required></textarea>
				</label>
				<!-- Honeypot: real visitors never see or fill this. -->
				<input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<button class="submit t-body-m-strong" type="submit">
					<span class="roll"><span data-text="Submit">Submit</span></span>
				</button>
			</form>
		</div>
	</div>
	<Faq />
</Base>

<style>
	.page {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 60px;
		max-width: 600px;
		margin: 0 auto;
		padding-top: 140px;
	}
	header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		width: 100%;
		max-width: 400px;
	}
	h1 {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0 12px;
	}
	.accent {
		color: var(--primary-04);
	}
	header p {
		width: 100%;
		text-align: center;
		text-wrap: balance;
	}

	.form-card {
		width: 100%;
		padding: 12px;
		border-radius: 40px;
		background: var(--primary-02);
	}
	form {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 20px;
		border-radius: 28px;
		background: var(--neutral-01);
		box-shadow:
			inset 0 0 0 1px var(--primary-03),
			0 0.6px 0.6px -1.25px rgb(0 0 0 / 0.18),
			0 2.29px 2.29px -2.5px rgb(0 0 0 / 0.16),
			0 10px 10px -3.75px rgb(0 0 0 / 0.06);
	}
	label {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	label > span {
		color: var(--neutral-07);
	}
	.message {
		padding-bottom: 16px;
	}
	input,
	textarea {
		width: 100%;
		padding: 14px;
		border: 1px solid var(--neutral-04);
		border-radius: 10px;
		background: var(--neutral-02);
		color: var(--neutral-08);
		font: 400 16px/1.2 var(--font-display);
		letter-spacing: 0;
		transition:
			background-color 0.2s var(--ease),
			border-color 0.2s var(--ease);
	}
	input {
		height: 44px;
	}
	textarea {
		min-height: 160px;
		resize: vertical;
	}
	input::placeholder,
	textarea::placeholder {
		color: var(--neutral-06);
	}
	input:focus,
	textarea:focus {
		outline: none;
		border-color: var(--primary-03);
		background: var(--neutral-01);
	}
	.trap {
		position: absolute;
		width: 0;
		height: 0;
		padding: 0;
		border: 0;
		opacity: 0;
		pointer-events: none;
	}
	.submit {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 44px;
		border-radius: 12px;
		background: var(--neutral-08);
		color: var(--neutral-01);
	}
	.submit .roll {
		height: 23px;
	}

	@media (max-width: 809px) {
		.page {
			gap: 40px;
			padding: 100px 20px 0;
		}
		header p {
			text-wrap: wrap;
		}
		.form-card {
			padding: 8px;
			border-radius: 24px;
		}
		form {
			border-radius: 16px;
		}
	}
</style>
